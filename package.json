{
  "name": "airlock",
  "private": true,
  "type": "module",
  "description": "Before you run a stranger's code, let a fenced agent open it first.",
  "license": "MIT",
  "workspaces": ["web"],
  "engines": { "node": ">=24.22.1" },
  "scripts": {
    "start": "node --no-warnings server/main.ts",
    "build": "npm run build -w @airlock/web",
    "dev": "npm run dev -w @airlock/web",
    "scan": "node --no-warnings server/cli.ts",
    "scan:private": "node --no-warnings server/private-cli.ts",
    "models": "node --no-warnings server/near-models.ts",
    "verify:receipt": "node --no-warnings server/verify-receipt.ts",
    "verify:offline": "node --no-warnings server/verify-receipt.ts --fixtures",
    "bench": "node --no-warnings server/bench.ts",
    "metrics": "node --no-warnings server/bench.ts --render",
    "judge": "node --no-warnings server/judge.ts",
    "registry": "node --no-warnings server/registry.ts",
    "test:contract": "cd contracts/verdict-registry && cargo test",
    "test": "node --no-warnings --test \"server/test/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.299",
    "@hono/node-server": "^2.1.5",
    "@nearai/inference-sdk": "0.2.1",
    "@phala/dcap-qvl": "0.7.0",
    "hono": "^4.13.13",
    "near-api-js": "7.4.0",
    "tweetnacl": "1.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
