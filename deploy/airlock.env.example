# Copy to deploy/airlock.env and fill in. Never commit the real file.
ANTHROPIC_API_KEY=
ARMORIQ_API_KEY=
AIRLOCK_MODEL=claude-haiku-5-5
AIRLOCK_DAILY_USD=10
AIRLOCK_PER_IP_HOUR=6
# Optional: raises GitHub's API limit for the size check.
GITHUB_TOKEN=

# NEAR AI Cloud engine. Setting NEARAI_API_KEY switches hosted reviews to private review in a TEE,
# with a receipt for every scan. Leave it empty to keep the Claude review above.
NEARAI_API_KEY=
AIRLOCK_NEAR_MODEL=Qwen/Qwen3.8-27B
AIRLOCK_NEAR_MAX_USD=0.05
# Optional: record each verdict on NEAR testnet with the recorder's function-call key.
NEAR_ACCOUNT_ID=
NEAR_PRIVATE_KEY=

# Optional: run each repository's install steps in the sandbox first (server/sandbox). Use a Vercel
# account of its own: the VMs run strangers' code. Limits for a public server, with their defaults:
AIRLOCK_SANDBOX=
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
AIRLOCK_SANDBOX_STEP_SECONDS=60
AIRLOCK_SANDBOX_MAX_STEPS=3
AIRLOCK_SANDBOX_MAX_SECONDS=240
AIRLOCK_SANDBOX_PER_DAY=60
